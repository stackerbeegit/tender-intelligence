# =============================================================================
# Stackerbee Tender Intelligence & Opportunity Management Platform
# Environment configuration template.
# Copy to `.env` and fill in real values. NEVER commit the real `.env` file.
# =============================================================================

# --- General ---
ENVIRONMENT=development           # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
TZ=Asia/Kolkata

# --- Backend / API ---
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Security / Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stackerbee_tender
POSTGRES_USER=stackerbee
POSTGRES_PASSWORD=changeme-strong-password
DATABASE_URL=postgresql+psycopg://stackerbee:changeme-strong-password@postgres:5432/stackerbee_tender

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (S3-compatible / MinIO) ---
STORAGE_PROVIDER=minio             # minio | s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=changeme-access-key
S3_SECRET_KEY=changeme-secret-key
S3_BUCKET_NAME=tender-documents
S3_REGION=ap-south-1
S3_USE_SSL=false

# --- LLM Provider Abstraction ---
# Supported: openai | anthropic | local
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- Embeddings (for pgvector semantic search) ---
EMBEDDING_PROVIDER=openai          # openai | anthropic | local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Notifications ---
NOTIFICATIONS_EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@stackerbee.com
SMTP_USE_TLS=true

# --- Crawler / Connector behaviour ---
CRAWLER_DEFAULT_RATE_LIMIT_SECONDS=2
CRAWLER_DEFAULT_RETRY_ATTEMPTS=3
CRAWLER_USER_AGENT=StackerbeeTenderBot/1.0 (+https://stackerbee.com/bot)

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
