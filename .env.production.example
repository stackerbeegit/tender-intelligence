# =============================================================================
# Production environment for docker-compose.prod.yml.
# Copy to `.env` on the server and fill in every CHANGE_ME. Never commit it.
#
# Generate secrets with:   openssl rand -hex 32
# Use hex (letters/digits only) for POSTGRES_PASSWORD — it is embedded in a
# connection URL, where characters like @ : / # would break it.
# =============================================================================

# --- General ---
LOG_LEVEL=INFO
TZ=Asia/Kolkata

# --- Security / Auth ---
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- PostgreSQL (container on the internal Docker network) ---
POSTGRES_DB=stackerbee_tender
POSTGRES_USER=stackerbee
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# --- Scheduled crawls (Celery Beat) ---
SCHEDULED_CRAWL_ENABLED=true
SCHEDULED_CRAWL_HOUR=1
SCHEDULED_CRAWL_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Kolkata

# --- AI analysis ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-opus-5-5
LLM_REQUEST_TIMEOUT_SECONDS=300

# --- Notifications (not used yet) ---
NOTIFICATIONS_EMAIL_ENABLED=false

# --- Crawler ---
CRAWLER_DEFAULT_RATE_LIMIT_SECONDS=2
CRAWLER_DEFAULT_RETRY_ATTEMPTS=3
CRAWLER_USER_AGENT=StackerbeeTenderBot/1.0 (+https://stackerbee.com/bot)

# --- docker-compose.prod.yml knobs ---
# Where the web container listens. "80" = every interface. To expose the app
# on the Tailscale network only, use the server's Tailscale IP: 100.x.y.z:80
WEB_BIND=80
BACKEND_WORKERS=2

# DATABASE_URL, REDIS_URL, CELERY_*, STORAGE_PROVIDER, ENVIRONMENT and DEBUG
# are set by docker-compose.prod.yml itself — don't set them here.
